rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isDocente() {
      return isAuthenticated() && (
        request.auth.token.email.matches('.*professor.*') ||
        request.auth.token.email.matches('.*docente.*') ||
        request.auth.token.email == 'WKabum@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'professor')
      );
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated() || isDocente();
    }

    match /simulados_realizados/{simuladoId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated() || isDocente();
    }

    match /provas_geradas/{provaId} {
      allow read: if true;
      allow write, delete: if isAuthenticated() || isDocente();
      allow create: if true;
    }

    match /forum_duvidas/{duvidaId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated() || isDocente();

      match /respostas/{respostaId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isAuthenticated() || isDocente();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
