{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil institucional de usuário (aluno ou professor)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "nome": { "type": "string" },
        "email": { "type": "string" },
        "papel": { "type": "string", "enum": ["aluno", "professor"] },
        "matriculaOuSiape": { "type": "string" },
        "turma": { "type": "string" },
        "criadoEm": { "type": "string" },
        "fotoPerfil": { "type": "string" }
      },
      "required": ["uid", "nome", "email", "papel", "matriculaOuSiape", "criadoEm"]
    },
    "SimuladoResultado": {
      "title": "SimuladoResultado",
      "description": "Registro de simulado concluído pelo discente",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "alunoId": { "type": "string" },
        "alunoNome": { "type": "string" },
        "alunoMatricula": { "type": "string" },
        "data": { "type": "string" },
        "timestamp": { "type": "number" },
        "nota": { "type": "number" },
        "acertos": { "type": "number" },
        "total": { "type": "number" },
        "dificuldade": { "type": "string" },
        "unidadeFiltro": { "type": "string" },
        "tempoGastoSegundos": { "type": "number" }
      },
      "required": ["id", "alunoId", "alunoNome", "alunoMatricula", "data", "nota", "acertos", "total"]
    },
    "ProvaDocente": {
      "title": "ProvaDocente",
      "description": "Instrumento avaliativo gerado pelo professor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titulo": { "type": "string" },
        "professorId": { "type": "string" },
        "unidade": { "type": "string" },
        "dificuldade": { "type": "string" },
        "qtdQuestoes": { "type": "number" },
        "criadaEm": { "type": "string" },
        "questoesIds": { "type": "string" }
      },
      "required": ["id", "titulo", "professorId", "criadaEm"]
    },
    "DuvidaForum": {
      "title": "DuvidaForum",
      "description": "Dúvida postada no fórum de aulas e estudos de caso",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "aulaId": { "type": "string" },
        "aulaTitulo": { "type": "string" },
        "titulo": { "type": "string" },
        "descricao": { "type": "string" },
        "autorId": { "type": "string" },
        "autorNome": { "type": "string" },
        "autorPapel": { "type": "string", "enum": ["aluno", "professor"] },
        "autorMatricula": { "type": "string" },
        "criadoEm": { "type": "string" },
        "timestamp": { "type": "number" },
        "votos": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["aberto", "respondido_professor", "resolvido"] }
      },
      "required": ["id", "aulaId", "titulo", "descricao", "autorId", "autorNome", "criadoEm"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Documentos de perfis de discentes e docentes"
    },
    "/simulados_realizados/{simuladoId}": {
      "schema": { "$ref": "#/entities/SimuladoResultado" },
      "description": "Histórico de simulados e avaliações realizadas pelos alunos"
    },
    "/provas_geradas/{provaId}": {
      "schema": { "$ref": "#/entities/ProvaDocente" },
      "description": "Provas e listas de exercícios elaboradas pelo docente"
    },
    "/forum_duvidas/{duvidaId}": {
      "schema": { "$ref": "#/entities/DuvidaForum" },
      "description": "Tópicos de dúvidas por aula e estudos de caso"
    }
  }
}
